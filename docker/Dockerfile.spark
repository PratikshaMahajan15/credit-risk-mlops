# Runs the PySpark ETL inside the same Docker network as the Hadoop (HDFS) containers.
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends default-jre-headless procps \
    && rm -rf /var/lib/apt/lists/*
ENV JAVA_HOME=/usr/lib/jvm/default-java

WORKDIR /app
RUN pip install --no-cache-dir pyspark pandas pyarrow
COPY src ./src

CMD ["python", "-m", "src.spark_hdfs_etl"]
